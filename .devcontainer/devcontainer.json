{
  "name": "Harbour Bank data stack",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "moby": false
    }
  },
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb"
  },
  "postCreateCommand": "./scripts/install-airflow.sh",
  "postStartCommand": "docker compose up -d --wait",
  "forwardPorts": [
    8080,
    9092,
    5432
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ]
    }
  },
  "portsAttributes": {
    "8080": {
      "label": "Airflow UI"
    }
  }
}
